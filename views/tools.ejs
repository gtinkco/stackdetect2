<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tools</title>
    <link rel="stylesheet" href="/css/dashboard.css"> 
    <link rel="stylesheet" href="/css/tools.css"> <!-- Include the general styles -->
    <link rel="stylesheet" href="/css/styles.css"> <!-- Include the general styles -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="profile-summary">
                <i class="profile-icon fas fa-user-circle"></i> <!-- Font Awesome Icon -->
                <h3><%= username %></h3>
                <p>Plan: <%= plan %></p>
            </div>
            <ul class="menu">
                <li><a href="/dashboard"><span class="icon">🏠</span> Dashboard</a></li>
                <li><a href="/tools" class="active"><span class="icon">🛠️</span> Tools</a></li>
                <li><a href="/code-snippets"><span class="icon">💾</span> Code Snippet</a></li>
                <li><a href="/task"><span class="icon">📋</span> Tasks</a></li>
                <li><a href="/notifications"><span class="icon">🔔</span> ### </a></li>
                <li><a href="/trendingtechnologies"><span class="icon">🚀</span> Trending Technologies</a></li>
                <li><a href="/techstack"><span class="icon">🖥️</span> Tech Stack</a></li>
                <li><a href="/api"><span class="icon">📘</span> API Analyzer</a></li>
                <li><a href="/"><span class="icon">🔓</span> Log Out</a></li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="dashboard-header">
                <h1>Tools</h1>
                <p>Explore and access all tools available for your workflow.</p>
            </header>

            <!-- Explore Our Tools Section -->
            <section class="tools-container">
                <h2>Explore Our Tools</h2>
                <div class="tool-buttons">
                    <div class="tool-button">
                        <button onclick="window.location.href='/techstack.html'">Tech Stack Breakdown</button>
                        <p>Analyze the technology stacks used by industry leaders.</p>
                    </div>
                    <div class="tool-button">
                        <button onclick="window.location.href='/api.html'">API Analyzer</button>
                        <p>Monitor your API usage and stats in real-time.</p>
                    </div>
                    <div class="tool-button">
                        <button onclick="window.location.href='/market.html'">Marketplace Analyzer</button>
                        <p>Analyze and optimize your marketplace strategy with powerful insights and tools.
                        </p>
                    </div>
                    <div class="tool-button">
                        <button onclick="window.location.href='/tech-compatibility.html'">Tech Compatability Checker</button>
                        <p>Tech Compatibility Checker </p>
                    </div>
                    <div class="tool-button">
                        <button onclick="window.location.href='/leadgenerator.html'">Lead Generation Tool</button>
                        <p>Generate new leads with this powerful tool.</p>
                    </div>
                </div>
            </section>

            <!-- Recent Tools -->
            <section class="recent-tools">
                <h2>Recently Used Tools</h2>
                <ul class="recent-tools-list">
                    <li><a href="/task">Task Manager</a></li>
                    <li><a href="/api">API Tracker</a></li>
                    <li><a href="/team">Team Collaboration</a></li>
                </ul>
            </section>
        </main>
    </div>

    
</body>
</html>
