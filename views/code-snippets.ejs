<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Code Snippet - StackDetect</title>
    <link rel="stylesheet" href="/css/dashboard.css"> <!-- General dashboard styles -->
    <link rel="stylesheet" href="/css/tools.css"> <!-- Specific tool styles -->
    <link rel="stylesheet" href="/css/styles.css"> <!-- General styles -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <!-- Highlight.js -->
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/github-dark.min.css">
    <script src="//cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="profile-summary">
                <i class="profile-icon fas fa-user-circle"></i>
                <h3><%= username %></h3>
                <p>Plan: <%= plan %></p>
            </div>
            <ul class="menu">
                <li><a href="/dashboard"><span class="icon">🏠</span> Dashboard</a></li>
                <li><a href="/tools"><span class="icon">🛠️</span> Tools</a></li>
                <li><a href="/code-snippets" class="active"><span class="icon">💾</span> Code Snippet</a></li>
                <li><a href="/task"><span class="icon">📋</span> Tasks</a></li>
                <li><a href="/notifications"><span class="icon">🔔</span> ###</a></li>
                <li><a href="/trendingtechnologies"><span class="icon">🚀</span> Trending Technologies</a></li>
                <li><a href="/techstack"><span class="icon">🖥️</span> Tech Stack</a></li>
                <li><a href="/api"><span class="icon">📘</span> API Tracker</a></li>
                <li><a href="/"><span class="icon">🔓</span> Log Out</a></li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="dashboard-header">
                <h1>Code Snippets Repository</h1>
                <p>Save, search, and share your favorite code snippets.</p>
            </header>

            <!-- Code Snippets Section -->
            <section class="code-snippets-container">
                <div class="actions-bar">
                    <input type="text" id="searchInput" placeholder="Search snippets by title, category, or tags" oninput="filterSnippets()">
                    <button class="add-snippet-btn" onclick="window.location.href='/add-snippet'">Add New Snippet</button>
                </div>

                <div class="snippet-list" id="snippetList">
                    <!-- Example of a Code Snippet -->
                    <div class="snippet-card">
                        <h3>Array Filter Function</h3>
                        <pre><code class="language-javascript">const numbers = [1, 2, 3, 4, 5];
const evenNumbers = numbers.filter(num => num % 2 === 0);
console.log(evenNumbers);</code></pre>
                        <p><strong>Category:</strong> JavaScript</p>
                        <p><strong>Tags:</strong> #array #filter #javascript</p>
                        <div class="snippet-actions">
                            <button class="edit-btn">Edit</button>
                            <button class="delete-btn" onclick="deleteSnippet(this)">Delete</button>
                            <button class="share-btn">Share</button>
                        </div>
                    </div>
                    
                    <!-- Add additional snippets dynamically -->
                </div>
            </section>
        </main>
    </div>

    <script>
        function filterSnippets() {
            const searchInput = document.getElementById('searchInput').value.toLowerCase();
            const snippets = document.querySelectorAll('.snippet-card');

            snippets.forEach(snippet => {
                const text = snippet.textContent.toLowerCase();
                snippet.style.display = text.includes(searchInput) ? 'block' : 'none';
            });
        }

        function deleteSnippet(button) {
            const snippet = button.closest('.snippet-card');
            snippet.remove(); // Simulate deletion for now
            // Implement API call here to delete from the backend
        }
    </script>
</body>
</html>
